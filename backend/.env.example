# Copy to .env for local overrides. Never commit real .env files.

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional regex for extra origins, e.g. Vercel preview deployments
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Only needed if model_metadata.pkl uses different key names
# METADATA_FEATURES_KEY=feature_names
# METADATA_CONTINUOUS_KEY=continuous_features
